# Env mínimo para compose.worker.yml -- solo lo que necesitan queue:work y
# schedule:work (nada de sesiones web, nada de APP_URL/assets). APP_KEY debe
# ser el MISMO que usan los demás entornos (Docker local, modo sin Docker)
# porque todos comparten la misma BD -- no lo cambies por separado.
APP_NAME="CRM DIMSUM (worker)"
APP_ENV=staging
APP_KEY=base64:tqgRe4jCnnCmEYEwgCO6asb56hINsGs7WivZ2pMJ+ns=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_URL="pgsql://enciende_sistemas:Perulinux,.12345@2.25.104.73:5433/crm-dimsum?sslmode=disable"

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

FILAMENT_ADMIN_EMAILS=bcelestepoke@gmail.com

# Sobrescrito por compose.worker.yml (STOCK_GATEWAY_URL=http://gateway:3000)
# -- este valor solo aplica si se corre fuera de ese compose.
STOCK_GATEWAY_URL=http://127.0.0.1:3000
