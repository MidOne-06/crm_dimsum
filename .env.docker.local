# compose.yaml resuelve `env_file: - ${ENV_FILE:-.env.docker}`; sin esta variable
# los contenedores caerían de vuelta al .env.docker de producción.
ENV_FILE=.env.docker.local

APP_NAME="Panel Administrativo"
APP_ENV=staging
APP_KEY=base64:tqgRe4jCnnCmEYEwgCO6asb56hINsGs7WivZ2pMJ+ns=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_PORT=8090
VENTAS_WORKER_REPLICAS=20
APP_TIMEZONE=America/Lima
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Base compartida real en el VPS -- toma prioridad sobre DB_HOST/DB_DATABASE
# sueltos (ver config/database.php: 'url' reemplaza host/puerto/db/user/pass
# por completo cuando está presente). Docker, el modo local sin Docker y
# cualquier despliegue deben apuntar todos aquí para quedar sincronizados.
DB_URL="pgsql://enciende_sistemas:Perulinux,.12345@2.25.104.73:5433/crm-dimsum?sslmode=disable"
DB_DATABASE=opm_digemid_local
DB_USERNAME=opm_local
DB_PASSWORD=965744e194393ad76a54ebbaf725a5c4
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

FILAMENT_ADMIN_EMAILS=bcelestepoke@gmail.com

# El gateway Node (D:\DS-TI\API-TI, server.js) corre en el host Windows, fuera de
# Docker. Desde los contenedores app/worker no se puede usar 127.0.0.1 (apuntaría
# al propio contenedor) -- host.docker.internal es el nombre especial que Docker
# Desktop resuelve al host.
STOCK_GATEWAY_URL=http://host.docker.internal:3000

OPM_CATALOG_INDEX=/data/catalogo/catalog-index.json
OPM_CATALOG_SYNC_TIME=03:15
OPM_BATCH_PROCESSES=4
OPM_BATCH_CONCURRENT=4
OPM_DETAIL_CONCURRENT=8
OPM_PROXY_RETRY_ATTEMPTS=5
OPM_REQUEST_TIMEOUT_MS=30000
OPM_PROXY_URLS=

DATAIMPULSE_HOST=gw.dataimpulse.com
DATAIMPULSE_PORT=823
DATAIMPULSE_USER=
DATAIMPULSE_PASSWORD=
