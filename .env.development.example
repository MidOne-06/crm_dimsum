ENV_FILE=.env.development
APP_NAME="CRM DIMSUM - Desarrollo"
APP_ENV=local
APP_KEY=base64:CHANGE_ME
APP_DEBUG=true
APP_URL=http://localhost:8091
APP_PORT=8091
APP_TIMEZONE=America/Lima
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=crm_dimsum_development
DB_USERNAME=crm_dimsum_development
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

STOCK_GATEWAY_URL=http://127.0.0.1:9
VENTAS_PAYLOAD_ALLOW_LOCAL_ARCHIVE=false
ISOLATED_ENVIRONMENT=true
ISOLATED_ADMIN_NAME="Administrador de desarrollo"
ISOLATED_ADMIN_EMAIL=admin@crm-dimsum.test
ISOLATED_ADMIN_PASSWORD=CHANGE_ME
