APP_NAME="Panel Administrativo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=America/Lima
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_DATABASE=opm_digemid
DB_USERNAME=opm
DB_PASSWORD=change-this-to-a-long-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

FILAMENT_ADMIN_EMAILS=bcelestepoke@gmail.com

OPM_CATALOG_INDEX=/data/catalogo/catalog-index.json
OPM_CATALOG_SYNC_TIME=03:15
# Capacidad paralela: procesos × nombres × detalles. Ajustar gradualmente según CPU, red y plan de proxy.
OPM_BATCH_PROCESSES=4
OPM_BATCH_CONCURRENT=4
OPM_DETAIL_CONCURRENT=8
OPM_PROXY_RETRY_ATTEMPTS=5
OPM_REQUEST_TIMEOUT_MS=30000
# Lista opcional de gateways adicionales, separados por coma. Mantener solo en secretos, nunca en Git.
OPM_PROXY_URLS=

DATAIMPULSE_HOST=gw.dataimpulse.com
DATAIMPULSE_PORT=823
DATAIMPULSE_USER=
DATAIMPULSE_PASSWORD=
