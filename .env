APP_NAME="Panel Administrativo"
APP_ENV=local
APP_KEY=base64:oEqEcamWOSRO/NniaSgUtH6aAo31v4y3cIS8+ewPmrM=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8001

# Docker Compose interpola ${APP_PORT} en compose.yaml (ports:) leyendo el .env
# de la raíz, NO el env_file: de cada servicio -- por eso hace falta declararlo
# aquí también, aunque el resto de este archivo sea para el dev local (:8001).
APP_PORT=8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=opm_digemid_dev
DB_USERNAME=postgres
DB_PASSWORD=Nirvana159@__A

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# En producciÃ³n, solo estas cuentas pueden acceder al panel Filament.
# Use una lista separada por comas y no deje este valor vacÃ­o.
FILAMENT_ADMIN_EMAILS=bcelestepoke@gmail.com

# Ruta absoluta al Ã­ndice del catÃ¡logo que se procesa en cada ejecuciÃ³n.
OPM_CATALOG_INDEX=
OPM_BATCH_CONCURRENT=10
OPM_DETAIL_CONCURRENT=5

# Gateway Node (D:\DS-TI\API-TI) que mantiene la sesión con Logística Dim Sum.
STOCK_GATEWAY_URL=http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
