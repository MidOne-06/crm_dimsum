ENV_FILE=.env.staging
APP_NAME="CRM DIMSUM - Staging"
APP_ENV=staging
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=http://localhost:8092
APP_PORT=8092
APP_TIMEZONE=America/Lima
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=crm_dimsum_staging
DB_USERNAME=crm_dimsum_staging
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

STOCK_GATEWAY_URL=http://127.0.0.1:9
VENTAS_PAYLOAD_ALLOW_LOCAL_ARCHIVE=false
ISOLATED_ENVIRONMENT=true
ISOLATED_ADMIN_NAME="Administrador de staging"
ISOLATED_ADMIN_EMAIL=admin@crm-dimsum-staging.test
ISOLATED_ADMIN_PASSWORD=CHANGE_ME
